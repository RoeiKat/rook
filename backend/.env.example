DATABASE_URL=postgresql+asyncpg://rook:rook@localhost:5432/rook

OPENAI_API_KEY=

# Docker containers reach Ollama on the Windows host through this address.
OLLAMA_BASE_URL=http://host.docker.internal:11434

PINECONE_API_KEY=
PINECONE_INDEX=rook
PINECONE_NAMESPACE=documents

# Backend-only configuration. Generate a random secret of at least 32 characters.
SESSION_SECRET=
# Optional administrator access; no default credentials. Generate the password
# hash with: python -m app.auth
# Enclose the hash in single quotes to preserve its dollar signs in Docker Compose.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Separate password required before the administrator login page/API is accessible.
# Backend only: never copy this into VITE_* variables.
ADMIN_ACCESS_PASSWORD=

# Comma-separated exact browser origins; wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:5173
# Keep true with HTTPS in production. Set false explicitly for local HTTP only.
COOKIE_SECURE=true
