DATABASE_URL=postgresql+asyncpg://rook:rook@localhost:5432/rook
# Optional application override. Prefer the pooled Neon URL for normal traffic.
DATABASE_URL_POOLED=
# Use the direct Neon URL for startup schema migrations.
DATABASE_URL_UNPOOLED=
APP_ENV=development

OPENAI_API_KEY=

# Required. Docker containers reach a host Ollama instance through this address;
# production should point to the public URL of the self-hosted inference service.
OLLAMA_BASE_URL=http://host.docker.internal:11434

PINECONE_API_KEY=
PINECONE_INDEX=rook
PINECONE_NAMESPACE=documents

# Original knowledge-base document storage.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_PATH=/app/ingestion/documents
# Keep proxied Vercel uploads below the platform's 4.5 MB body limit.
DOCUMENT_UPLOAD_MAX_BYTES=4194304
# Required when DOCUMENT_STORAGE_PROVIDER=s3.
S3_BUCKET=rook-documents
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional during development; Rook supplies a local-only default.
# Required in production and must contain at least 32 random characters.
SESSION_SECRET=
# Optional administrator access; no default credentials. Generate the password
# hash with: python -m app.auth
# Enclose the hash in single quotes to preserve its dollar signs in Docker Compose.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Failed administrator logins allowed per source address during the window.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
# Comma-separated exact browser origins; wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:5173
# Leave empty to default to false in development and true in production.
COOKIE_SECURE=
# Keep true for the first deployment, then run migrations explicitly before
# later releases and set this to false: python -m app.database.migrate
MIGRATE_ON_STARTUP=
