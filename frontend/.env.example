# Browser API URL. Leave empty when using the Vite proxy or Docker Compose.
VITE_API_URL=

# Unadvertised administrator page path. This is visible in the compiled browser
# bundle and is an additional obscurity layer, not a replacement for authentication.
VITE_ADMIN_PATH=/admin

# Vite development proxy target. Vercel Services routes /api internally instead.
API_PROXY_TARGET=http://localhost:8000
